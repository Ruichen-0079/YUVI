MEM0_SIDECAR_HOST=127.0.0.1
MEM0_SIDECAR_PORT=6131

MEM0_EMBEDDER_PROVIDER=ollama
# YUVI-tuned Ollama model (same qwen3-embedding:0.6b weights, num_ctx=2048).
MEM0_EMBEDDER_MODEL=yuvi-embedding:0.6b
MEM0_EMBEDDER_DIMENSIONS=1024
MEM0_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Example: postgres://yuvi:yuvi_dev_password@127.0.0.1:5432/yuvi
MEM0_PG_CONNECTION_STRING=
MEM0_PG_COLLECTION=yuvi_mem0_qwen3_1024_v1
MEM0_PG_HNSW=true
MEM0_PG_DISKANN=false

# Independent Memory LLM (required for infer=true). Do NOT reuse chat keys in git.
# Recommended for mem0ai 2.2.1 fact update/delete tools:
#   MEM0_LLM_PROVIDER=deepseek
#   MEM0_LLM_MODEL=deepseek-chat
#   MEM0_LLM_BASE_URL=https://api.deepseek.com
# OpenAI-compatible also works for many models (provider=openai + openai_base_url).
MEM0_LLM_PROVIDER=deepseek
MEM0_LLM_MODEL=
MEM0_LLM_API_KEY=
MEM0_LLM_BASE_URL=
MEM0_LLM_TEMPERATURE=0.0
MEM0_LLM_TIMEOUT_MS=30000

MEM0_REQUEST_TIMEOUT_MS=5000
MEM0_LOG_CONTENT=false
