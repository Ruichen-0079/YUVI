# AI Companion Runtime 环境变量示例
# 复制本文件为 .env 后再填写本地配置。
# 不要在本文件中写入真实 API key。
# secret、API key、Authorization header、token、password 绝不能被日志打印。

# -----------------------------
# Server
# -----------------------------
# 本地开发默认使用 development。
NODE_ENV=development

# Server 监听地址和端口。
SERVER_HOST=127.0.0.1
SERVER_PORT=6121

# Web dashboard defaults to loopback for local development.
# Set YUVI_WEB_HOST=0.0.0.0 only when you intentionally expose it on the LAN.
YUVI_WEB_HOST=127.0.0.1
YUVI_WEB_PORT=5173
WEB_PORT=5173
VITE_LIVE2D_MODEL_URL=/api/live2d/Lumi/Lumi.model3.json

# Optional local-only Live2D asset root. The server exposes read-only model
# files under /live2d and never accepts arbitrary filesystem paths from the browser.
LIVE2D_ASSET_ROOT=
# Official Cubism SDK for Web Core only; do not point this at a VTube Studio DLL.
# Expected file name: live2dcubismcore.min.js
LIVE2D_CORE_PATH=

# -----------------------------
# Database
# -----------------------------
# 默认开发模式使用内存存储，不要求数据库迁移。
# 如需启用 PostgreSQL memory，请改为 MEMORY_REPOSITORY=postgres，
# 确保 DATABASE_URL 已填写，并先运行 pnpm db:migrate。
MEMORY_REPOSITORY=in-memory
# Formal long-term memory backend: mem0 (default for local dev) | legacy
# Runtime does not require Mem0 Sidecar to be healthy at boot.
MEMORY_BACKEND=mem0
# Optional PostgreSQL semantic retrieval calls; keep off until workload/cost validation.
MEMORY_QUERY_EXPANSION_ENABLED=false
MEMORY_EVIDENCE_SUPPORT_ENABLED=false
MEM0_BASE_URL=http://127.0.0.1:6131
# Chat-path Mem0 search timeout (ms). Writes run async in the background.
MEM0_RUNTIME_TIMEOUT_MS=600
MEM0_RUNTIME_HEALTH_TIMEOUT_MS=1000
# Explicit local single-user Mem0 scope (required when request omits IDs).
# Never uses silent default-user / default-persona for Mem0.
MEMORY_SUBJECT_USER_ID=local-user
MEMORY_PERSONA_ID=lumi

# -----------------------------
# Desktop service orchestration (Tauri main window)
# -----------------------------
# Autostart only affects YUVI-owned child processes; external healthy services are connected, never killed.
YUVI_AUTOSTART_RUNTIME=true
YUVI_AUTOSTART_MEM0=true
# TTS autostart requires explicit start commands below (no model-path guessing).
YUVI_AUTOSTART_TTS=false
# Optional explicit start commands (space-separated). Leave empty to detect/connect only.
# YUVI_RUNTIME_START_COMMAND=
# Optional external Python 3.11 interpreter; otherwise use services/memory-mem0/.venv.
# YUVI_MEM0_PYTHON=
# YUVI_MEM0_START_COMMAND=
# YUVI_TTS_WRAPPER_START_COMMAND=
# YUVI_TTS_UPSTREAM_START_COMMAND=
# Conversation persistence follows MEMORY_REPOSITORY unless explicitly overridden.
# Valid values: in-memory, memory, postgres. In-memory survives Runtime recreation only;
# PostgreSQL is required for recovery after a process restart.
CONVERSATION_REPOSITORY=in-memory

# llm：默认使用 ReasoningProvider 辅助提出候选记忆；仅在 writeMemory=true 时可能消耗 reasoning token。
# rule-based：确定性 fallback，不消耗模型 token。
MEMORY_EXTRACTOR=llm

# Direct Context 是短期同会话上下文，默认开启；它进入 prompt，但不会默认写入长期记忆。
DIRECT_CONTEXT_ENABLED=true
DIRECT_CONTEXT_MAX_TURNS=6
DIRECT_CONTEXT_MAX_CHARS=6000

# Memory Maintenance Scheduler v1 is disabled by default.
# It marks expired/stale state and audits supersession only; it never hard-deletes memories.
MEMORY_MAINTENANCE_ENABLED=false
MEMORY_MAINTENANCE_RUN_ON_STARTUP=false
MEMORY_MAINTENANCE_INTERVAL_MINUTES=0
MEMORY_MAINTENANCE_LIMIT=500

# Development supervisor support for Dashboard Deep Restart.
# scripts/dev.sh can auto-run db:migrate before server start/restart when PostgreSQL memory is active.
YUVI_DEV_SUPERVISOR=0
YUVI_AUTO_MIGRATE=1

# PostgreSQL + pgvector 开发数据库连接串。
# MEMORY_REPOSITORY=postgres 时必需；默认 in-memory 模式下不会使用。
# 与 infra/docker-compose.yml 中的 development-only 配置保持一致。
DATABASE_URL=postgres://yuvi:yuvi_dev_password@localhost:5432/yuvi

# Redis 用于未来 cache、session、rate-limit 等开发能力。
REDIS_URL=redis://localhost:6379

# NATS 用于未来事件总线和 JetStream 开发能力。
NATS_URL=nats://localhost:4222

# 事件总线边界。当前仅实现 in-memory；nats 是未来保留值。
EVENT_BUS=in-memory

# 可选 Dashboard 开发访问令牌。设置后，敏感开发端点需要 X-YUVI-Dev-Token。
# 仅用于本地开发保护，不要填写真实生产 secret。
DASHBOARD_DEV_TOKEN=

# Provider 默认采用 real-first 行为；缺少必需配置时不再静默使用 mock。
# 测试、CI、离线开发可显式改为 PROVIDER_ALLOW_MOCKS=true。
PROVIDER_ALLOW_MOCKS=false
DEFAULT_CHAT_PROVIDER=openai-compatible
CHAT_PROVIDER_CHAIN=openai-compatible,deepseek,nvidia,local,mock
REASONING_PROVIDER_CHAIN=deepseek,nvidia,local,mock
EMBEDDING_PROVIDER_CHAIN=openai-compatible,nvidia,local,mock
TTS_PROVIDER_CHAIN=xai,local,mock
STT_PROVIDER_CHAIN=dashscope,local,mock
VISION_PROVIDER_CHAIN=xai,nvidia,local,mock

# -----------------------------
# Generic remote OpenAI-compatible Chat
# -----------------------------
# Use this for DeepInfra, OpenRouter, or another compatible gateway.
# The API base URL is the provider's OpenAI-compatible API root; Yuvi appends
# /chat/completions through the existing streaming transport.
OPENAI_COMPATIBLE_API_BASEURL=https://api.deepinfra.com/v1/openai
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# P6 uses one decision-only call, then generates V4 prose only for REQUEST_TEXT.
OPENAI_COMPATIBLE_PROACTIVE_DECISION_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENAI_COMPATIBLE_ASSISTANT_CONTINUATION_FORMAT=deepseek-v4

# -----------------------------
# DeepSeek
# -----------------------------
# MVP 必需：默认 Reasoning provider；Chat 使用上面的 generic remote provider。
DEEPSEEK_API_BASEURL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# -----------------------------
# xAI
# -----------------------------
# 可选：TTS 和 Vision runtime routes use provider-chain fallback; leave blank unless verifying real xAI calls.
XAI_API_BASEURL=https://api.x.ai/v1
XAI_API_KEY=
XAI_TTS_MODEL=
XAI_TTS_VOICE=
XAI_VISION_MODEL=

# -----------------------------
# Alibaba DashScope
# -----------------------------
# 可选：STT runtime routes use provider-chain fallback; leave blank unless verifying real DashScope STT calls.
DASHSCOPE_API_BASEURL=
DASHSCOPE_API_KEY=
DASHSCOPE_STT_MODEL=

# -----------------------------
# NVIDIA API / Local compatible providers
# -----------------------------
NVIDIA_API_BASEURL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=
NVIDIA_REASONING_MODEL=
NVIDIA_EMBEDDING_MODEL=
NVIDIA_EMBEDDING_DIMENSIONS=1536
NVIDIA_VISION_MODEL=

LOCAL_MODEL_BASEURL=
LOCAL_CHAT_MODEL=
LOCAL_REASONING_MODEL=
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_DIMENSIONS=1536
LOCAL_TTS_MODEL=
LOCAL_STT_MODEL=
LOCAL_VISION_MODEL=

# Optional local CPU STT sidecar. DesktopSupervisor observes it by default and
# only owns it when an explicit development start command is configured.
LOCAL_STT_BASE_URL=http://127.0.0.1:9876
YUVI_LOCAL_STT_START_COMMAND=
YUVI_AUTOSTART_LOCAL_STT=false

# Local GPT-SoVITS Alice stack. Japanese uses the managed wrapper; English and
# mixed-language text uses api_v2 with the configured Japanese reference clip.
GPT_SOVITS_TTS_BASE_URL=http://127.0.0.1:9881
GPT_SOVITS_TTS_UPSTREAM_URL=http://127.0.0.1:9880
# The managed GPT-SoVITS process loads these at startup; YUVI does not rewrite model files.
GPT_SOVITS_TTS_GPT_WEIGHTS=
GPT_SOVITS_TTS_SOVITS_WEIGHTS=
GPT_SOVITS_TTS_LANGUAGE=ja
GPT_SOVITS_TTS_SPEAKER=alice
GPT_SOVITS_TTS_STYLE=neutral
GPT_SOVITS_TTS_REFERENCE_RANK=0
GPT_SOVITS_TTS_REFERENCE_AUDIO=
GPT_SOVITS_TTS_REFERENCE_TEXT=
GPT_SOVITS_TTS_REFERENCE_LANGUAGE=ja
GPT_SOVITS_TTS_TEXT_SPLIT_METHOD=cut0
GPT_SOVITS_TTS_TOP_K=15
GPT_SOVITS_TTS_TOP_P=1
GPT_SOVITS_TTS_TEMPERATURE=1
GPT_SOVITS_TTS_REPETITION_PENALTY=1.35
GPT_SOVITS_TTS_SAMPLE_STEPS=32
GPT_SOVITS_TTS_TIMEOUT_MS=60000

# -----------------------------
# Embedding
# -----------------------------
# 默认推荐 openai-compatible real embedding；缺少配置时 memory search 会回退到 keyword/trigram/full-text。
# 显式离线/mock 模式：
# PROVIDER_ALLOW_MOCKS=true
# EMBEDDING_PROVIDER=mock
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_BASEURL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Optional pgvector ANN index acceleration for PostgreSQL memory.
# ANN indexing only accelerates vector search; keyword/trigram/full-text priority remains unchanged.
MEMORY_VECTOR_INDEX_ENABLED=true
MEMORY_VECTOR_INDEX_TYPE=hnsw
MEMORY_VECTOR_DISTANCE=cosine
MEMORY_VECTOR_IVFFLAT_PROBES=10
MEMORY_VECTOR_HNSW_EF_SEARCH=

# -----------------------------
# Runtime mode
# -----------------------------
# development 表示 WSL/Docker/pnpm 开发模式，不等同于未来桌面生产模式。
RUNTIME_MODE=development
