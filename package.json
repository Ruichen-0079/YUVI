{
  "name": "ai-companion-runtime",
  "version": "0.1.2",
  "private": true,
  "description": "Local-first, event-driven AI companion runtime.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @companion/server dev",
    "prepare:cubism-framework": "node scripts/prepare-cubism-framework.mjs",
    "prepare:fonts": "node scripts/prepare-product-fonts.mjs",
    "postinstall": "node scripts/prepare-cubism-framework.mjs",
    "build": "pnpm prepare:cubism-framework && pnpm prepare:fonts && tsc -b",
    "check": "pnpm prepare:cubism-framework && pnpm check:host-environment && tsc -b --pretty false",
    "check:host-environment": "node scripts/check-host-environment-safety.mjs",
    "test": "pnpm -r test && node --test scripts/local-attention.test.mjs scripts/check-host-environment-safety.node.mjs scripts/daily-use-linux.test.mjs scripts/typography-contract.test.mjs scripts/desktop-package/build-linux-mem0.test.mjs scripts/desktop-package/build-local-stt.test.mjs scripts/desktop-package/cubism-core-release-contract.test.mjs scripts/desktop-package/durable-memory-boot.test.mjs scripts/desktop-package/linux-static-web-server.test.mjs scripts/desktop-package/portable-configuration.test.mjs scripts/desktop-package/prepare-linux-daily.test.mjs scripts/desktop-package/provision-cubism-core.test.mjs scripts/desktop-package/release-identity.test.mjs scripts/desktop-package/stage-linux-postgres.test.mjs scripts/conformance/fault-surface.test.mjs",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:shell": "shfmt -w scripts/*.sh",
    "dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "stop:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "health:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/health.ps1",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset:dev": "bash scripts/db-reset-dev.sh",
    "memory:embed:backfill": "tsx scripts/memory-embed-backfill.ts",
    "memory:index:status": "tsx scripts/memory-index-status.ts",
    "memory:maintenance": "tsx scripts/memory-maintenance.ts",
    "smoke:postgres": "DATABASE_URL=postgres://yuvi:yuvi_dev_password@localhost:5432/yuvi pnpm db:migrate && MEMORY_REPOSITORY=postgres DATABASE_URL=postgres://yuvi:yuvi_dev_password@localhost:5432/yuvi pnpm smoke",
    "smoke:postgres:windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:DATABASE_URL='postgres://yuvi:yuvi_dev_password@localhost:5432/yuvi'; pnpm db:migrate; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $env:MEMORY_REPOSITORY='postgres'; pnpm smoke\"",
    "desktop:package:prepare": "pnpm --filter @companion/server... build && node scripts/desktop-package/prepare.mjs",
    "desktop:package:smoke": "node scripts/desktop-package/smoke.mjs",
    "desktop:package:test": "node --test scripts/typography-contract.test.mjs scripts/desktop-package/build-mem0.test.mjs scripts/desktop-package/build-linux-mem0.test.mjs scripts/desktop-package/build-local-stt.test.mjs scripts/desktop-package/cubism-core-release-contract.test.mjs scripts/desktop-package/durable-memory-boot.test.mjs scripts/desktop-package/linux-static-web-server.test.mjs scripts/desktop-package/portable-configuration.test.mjs scripts/desktop-package/prepare.test.mjs scripts/desktop-package/prepare-linux-daily.test.mjs scripts/desktop-package/provision-cubism-core.test.mjs scripts/desktop-package/stage-linux-postgres.test.mjs",
    "desktop:package:linux-stt-smoke": "node scripts/desktop-package/linux-local-stt-smoke.mjs",
    "desktop:package:linux-audit": "node scripts/desktop-package/audit-linux-public-artifact.mjs",
    "local-stt:provision": "node scripts/provision-local-stt.mjs",
    "desktop:installer:smoke": "node scripts/desktop-package/installer-smoke.mjs",
    "desktop:installer:test": "node --test scripts/desktop-package/installer-smoke.test.mjs",
    "desktop:build:windows": "pnpm --filter @companion/desktop exec tauri build --bundles nsis",
    "desktop:smoke:linux": "node scripts/desktop-smoke-linux.mjs",
    "desktop:close-tray:linux": "node scripts/desktop-close-tray-lifecycle-linux.mjs",
    "daily:linux": "tsx scripts/install-daily-use-linux.mts",
    "accept:linux": "tsx scripts/test-daily-use-linux.mts --run",
    "desktop:package:linux-daily": "node scripts/desktop-package/prepare-linux-daily.mjs",
    "test:conformance": "node scripts/conformance/durable-gate.mjs"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@yao-pkg/pkg": "5.16.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
