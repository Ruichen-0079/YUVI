{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@companion/database": ["packages/database/src/index.ts"],
      "@companion/journal": ["packages/journal/src/index.ts"],
      "@companion/core": ["packages/core/src/index.ts"],
      "@companion/event-bus": ["packages/event-bus/src/index.ts"],
      "@companion/host-environment": ["packages/host-environment/src/index.ts"],
      "@companion/memory": ["packages/memory/src/index.ts"],
      "@companion/prompt-builder": ["packages/prompt-builder/src/index.ts"],
      "@companion/config": ["packages/config/src/index.ts"],
      "@companion/protocol": ["packages/protocol/src/index.ts"],
      "@companion/providers": ["packages/providers/src/index.ts"],
      "@companion/desktop-supervisor": ["packages/desktop-supervisor/src/index.ts"]
    }
  }
}
