{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YUVI Companion",
  "version": "0.1.2",
  "identifier": "com.yuvi.companion",
  "build": {
    "beforeDevCommand": "pnpm --filter @companion/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node ../../scripts/desktop-package/prepare.mjs && pnpm --dir ../.. --filter @companion/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' yuvi-asset://localhost/live2d-core/live2dcubismcore.min.js http://yuvi-asset.localhost/live2d-core/live2dcubismcore.min.js https://yuvi-asset.localhost/live2d-core/live2dcubismcore.min.js",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost yuvi-asset: http://yuvi-asset.localhost https://yuvi-asset.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost yuvi-asset: http://yuvi-asset.localhost https://yuvi-asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' blob: yuvi-asset: http://yuvi-asset.localhost https://yuvi-asset.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
