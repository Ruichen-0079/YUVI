{
  "name": "@companion/cognition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./capability-observation": {
      "types": "./src/capability-observation.ts",
      "development": "./src/capability-observation.ts",
      "import": "./dist/capability-observation.js"
    },
    "./post-capability-task": {
      "types": "./src/post-capability-task.ts",
      "development": "./src/post-capability-task.ts",
      "import": "./dist/post-capability-task.js"
    },
    "./capability-aware-task": {
      "types": "./src/capability-aware-task.ts",
      "development": "./src/capability-aware-task.ts",
      "import": "./dist/capability-aware-task.js"
    },
    "./interaction-round": {
      "types": "./src/interaction-round.ts",
      "development": "./src/interaction-round.ts",
      "import": "./dist/interaction-round.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "check": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run --passWithNoTests && pnpm run test:runtime-import",
    "test:runtime-import": "tsc -b tsconfig.json && node --input-type=module -e \"await import('./dist/index.js'); await import('./dist/capability-observation.js'); await import('./dist/post-capability-task.js'); await import('./dist/capability-aware-task.js'); await import('@companion/cognition/interaction-round'); await import('../character-harness/dist/cognition-result.js')\""
  },
  "dependencies": {
    "@companion/character-abi": "workspace:*",
    "@companion/character-harness": "workspace:*",
    "@companion/prompt-builder": "workspace:*",
    "@companion/providers": "workspace:*"
  }
}
